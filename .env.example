# ── Stellar / Soroban ──────────────────────────────────────────────────────────
# Soroban RPC endpoint
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed contract addresses (copy from conduit-contracts/.contract-ids/<network>.json)
NEXT_PUBLIC_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_GOVERNOR_CONTRACT_ID=

# Optional: Horizon for account info / balance lookups
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: multiplier over the network's observed inclusion fee for contract
# transactions. Defaults to 2. Raise it on congested ledgers.
NEXT_PUBLIC_SOROBAN_FEE_MULTIPLIER=2

# ── Demo Mode ──────────────────────────────────────────────────────────────────
# Set to "true" to run the app with mock data (no real contract calls).
# When empty or unset, the app requires a valid NEXT_PUBLIC_FACTORY_CONTRACT_ID.
NEXT_PUBLIC_DEMO_MODE=
